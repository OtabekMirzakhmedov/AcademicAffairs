// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // admin, departmenthead, teacher
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id                 Int      @id @default(autoincrement())
  login              String   @unique
  password           String // Hashed password
  roleId             Int      @map("role_id")
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  refreshTokenVersion Int     @default(0) @map("refresh_token_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  role                     Role                        @relation(fields: [roleId], references: [id])
  userInfo                 UserInfo?
  teacherInfo              TeacherInfo?
  headedDepartments        Department[]                @relation("DepartmentHead")
  courseAssignments        CourseTeacher[]
  teachingActivities       TeachingActivity[]
  validatedActivities      TeachingActivity[]          @relation("ValidatedBy")
  createdPrograms          Program[]                   @relation("ProgramCreator")
  createdScientificTasks   ScientificTask[]            @relation("ScientificTaskCreator")
  scientificReports        TeacherScientificReport[]   @relation("TeacherScientificReports")
  validatedScientificReports TeacherScientificReport[] @relation("ScientificReportValidator")
  publications             TeacherPublication[]
  validatedPublications    TeacherPublication[]      @relation("PublicationValidator")
  researchActivities       TeacherResearchActivity[] @relation("TeacherResearchActivities")
  validatedResearchActivities TeacherResearchActivity[] @relation("ResearchActivityValidator")
  auditLogs                AuditLog[]

  @@map("users")
}

model UserInfo {
  id                      Int       @id @default(autoincrement())
  userId                  Int       @unique @map("user_id")
  firstName               String    @map("first_name")
  lastName                String    @map("last_name")
  middleName              String?   @map("middle_name")
  dateOfBirth             DateTime? @map("date_of_birth")
  gender                  String?   // male, female, other
  nationality             String?
  countryOfBirth          String?   @map("country_of_birth")
  regionOfBirth           String?   @map("region_of_birth")
  currentAddress          String?   @map("current_address")
  permanentAddress        String?   @map("permanent_address")
  passportSerial          String?   @map("passport_serial")
  personalId              String?   @map("personal_id") // 14 digits
  stirInn                 String?   @map("stir_inn")
  englishLevel            String?   @map("english_level") // A1, A2, B1, B2, C1, C2
  profileImage            String?   @map("profile_image")
  locale                  String?   @default("uz") // uz, ru, en
  email1                  String?   @map("email_1")
  email2                  String?   @map("email_2")
  phone1                  String?   @map("phone_1")
  phone2                  String?   @map("phone_2")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_info")
}

model AcademicPeriod {
  id           Int      @id @default(autoincrement())
  academicYear String   @map("academic_year") // e.g., 2024-2025
  semester     Int // 1 or 2
  teachingWeek Int      @map("teaching_week") // Current week number in semester
  isActive     Boolean  @default(false) @map("is_active") // Only one period can be active
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  courseAssignments  CourseTeacher[]
  teachingActivities TeachingActivity[]

  @@map("academic_periods")
}

model Department {
  id         Int      @id @default(autoincrement())
  name       String
  headId     Int?     @map("head_id") // Department head user ID
  phone      String?
  roomNumber String?  @map("room_number")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  head             User?              @relation("DepartmentHead", fields: [headId], references: [id])
  teachers         TeacherInfo[]
  courses          Course[]
  programs         Program[]
  scientificTasks  ScientificTask[]

  @@map("departments")
}

model TeacherInfo {
  id                              Int      @id @default(autoincrement())
  userId                          Int      @unique @map("user_id")
  employmentType                  String?  @map("employment_type") // full-time, part-time, contract - set by dept head, nullable
  departmentId                    Int      @map("department_id") // Set by admin when assigning teacher to department
  mandatoryHoursPerPeriod         Decimal? @map("mandatory_hours_per_period") // Set by dept head or admin, nullable
  mandatoryExtracurricularHours   Decimal? @default(0) @map("mandatory_extracurricular_hours") // Set by dept head or admin
  mandatoryConferenceArticles     Int?     @default(0) @map("mandatory_conference_articles") // Set by dept head or admin
  mandatoryNationalArticles       Int?     @default(0) @map("mandatory_national_articles") // Set by dept head or admin
  mandatoryScopusArticles         Int?     @default(0) @map("mandatory_scopus_articles") // Set by dept head or admin
  mandatoryDocumentation          Int?     @default(0) @map("mandatory_documentation") // Set by dept head or admin

  // Educational Background - Bachelor
  bachelorUniversity              String?  @map("bachelor_university")
  bachelorYear                    Int?     @map("bachelor_year")
  bachelorDirection               String?  @map("bachelor_direction")
  bachelorDiplomaNumber           String?  @map("bachelor_diploma_number")

  // Educational Background - Master
  masterUniversity                String?  @map("master_university")
  masterYear                      Int?     @map("master_year")
  masterDirection                 String?  @map("master_direction")
  masterDiplomaNumber             String?  @map("master_diploma_number")

  // Research
  researchArea                    String?  @map("research_area")

  // PhD Information
  hasPhdDegree                    Boolean? @default(false) @map("has_phd_degree")
  phdYear                         Int?     @map("phd_year")
  phdSpeciality                   String?  @map("phd_speciality")
  phdTopic                        String?  @map("phd_topic")
  phdDiplomaNumber                String?  @map("phd_diploma_number")
  phdCountry                      String?  @map("phd_country")
  phdOrganization                 String?  @map("phd_organization")

  // DSc Information
  hasDscDegree                    Boolean? @default(false) @map("has_dsc_degree")
  dscYear                         Int?     @map("dsc_year")
  dscSpeciality                   String?  @map("dsc_speciality")
  dscTopic                        String?  @map("dsc_topic")
  dscDiplomaNumber                String?  @map("dsc_diploma_number")
  dscCountry                      String?  @map("dsc_country")
  dscOrganization                 String?  @map("dsc_organization")

  // Academic Title
  hasAcademicTitle                Boolean? @default(false) @map("has_academic_title")
  academicTitleName               String?  @map("academic_title_name")
  academicTitleSpeciality         String?  @map("academic_title_speciality")
  academicTitleYear               Int?     @map("academic_title_year")
  academicTitleAttestat           String?  @map("academic_title_attestat")

  // Training and Development
  internshipsCount                Int?     @default(0) @map("internships_count")
  internshipsInfo                 String?  @map("internships_info")
  trainingCount                   Int?     @default(0) @map("training_count")
  trainingInfo                    String?  @map("training_info")

  // Awards and Recognition
  awardsField                     String?  @map("awards_field")
  awardsState                     String?  @map("awards_state")

  // Supervision
  supervisedPhd                   Int?     @default(0) @map("supervised_phd")
  supervisedDsc                   Int?     @default(0) @map("supervised_dsc")

  // Conference and Seminar Participation
  conferencesRepublic             Int?     @default(0) @map("conferences_republic")
  conferencesInternational        Int?     @default(0) @map("conferences_international")
  seminarsRepublic                Int?     @default(0) @map("seminars_republic")
  seminarsInternational           Int?     @default(0) @map("seminars_international")

  // Projects
  projectsFundamental             Int?     @default(0) @map("projects_fundamental")
  projectsPractical               Int?     @default(0) @map("projects_practical")
  projectsYouth                   Int?     @default(0) @map("projects_youth")
  projectsBusiness                Int?     @default(0) @map("projects_business")
  projectsInnovation              Int?     @default(0) @map("projects_innovation")
  innovativeIdeasCount            Int?     @default(0) @map("innovative_ideas_count")

  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@map("teacher_info")
}

model Course {
  id            Int      @id @default(autoincrement())
  departmentId  Int      @map("department_id")
  name          String
  lectureHours  Decimal  @default(0) @map("lecture_hours")
  practiceHours Decimal  @default(0) @map("practice_hours")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  department         Department         @relation(fields: [departmentId], references: [id])
  assignedTeachers   CourseTeacher[]
  teachingActivities TeachingActivity[]
  programCourses     ProgramCourse[]

  @@map("courses")
}

model CourseTeacher {
  id               Int      @id @default(autoincrement())
  courseId         Int      @map("course_id")
  teacherId        Int      @map("teacher_id")
  academicPeriodId Int      @map("academic_period_id")
  groups           Json? // Optional: Array of group names, can be set by dept head or null
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  course           Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher          User               @relation(fields: [teacherId], references: [id])
  academicPeriod   AcademicPeriod     @relation(fields: [academicPeriodId], references: [id])
  teachingActivities TeachingActivity[]

  @@map("course_teachers")
}

model TeachingActivity {
  id               Int       @id @default(autoincrement())
  courseTeacherId  Int       @map("course_teacher_id") // Links to the course assignment
  teacherId        Int       @map("teacher_id")
  courseId         Int       @map("course_id")
  academicPeriodId Int       @map("academic_period_id")
  groups           Json // Array of group names entered by teacher
  lectureHours     Decimal   @default(0) @map("lecture_hours")
  practiceHours    Decimal   @default(0) @map("practice_hours")
  labHours         Decimal   @default(0) @map("lab_hours")
  seminarHours     Decimal   @default(0) @map("seminar_hours")
  advisingHours    Decimal   @default(0) @map("advising_hours")
  totalHours       Decimal   @default(0) @map("total_hours") // Calculated sum but stored
  status           String    @default("draft") // draft, submitted, validated, rejected
  submittedAt      DateTime? @map("submitted_at")
  validatedAt      DateTime? @map("validated_at")
  validatedBy      Int?      @map("validated_by") // Dept head who validated
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  courseTeacher  CourseTeacher  @relation(fields: [courseTeacherId], references: [id], onDelete: Cascade)
  teacher        User           @relation(fields: [teacherId], references: [id])
  course         Course         @relation(fields: [courseId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  validator      User?          @relation("ValidatedBy", fields: [validatedBy], references: [id])

  @@map("teaching_activities")
}

model Program {
  id                    Int       @id @default(autoincrement())
  name                  String // Mechanical Engineering, Mechatronics, etc.
  code                  String    @unique // ME-MECH, ME-MECHA, etc.
  degreeLevel           String    @map("degree_level") // BACHELOR, MASTER, DOCTORATE, UNDERGRADUATE, GRADUATE
  departmentId          Int       @map("department_id")
  durationYears         Int       @map("duration_years") // Program duration in years
  totalCreditsRequired  Decimal   @map("total_credits_required")
  description           String?
  isActive              Boolean   @default(true) @map("is_active")
  createdBy             Int       @map("created_by") // ADMIN or HEAD_OF_DEPARTMENT
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  department            Department      @relation(fields: [departmentId], references: [id])
  creator               User            @relation("ProgramCreator", fields: [createdBy], references: [id])
  programCourses        ProgramCourse[]

  @@index([departmentId])
  @@index([degreeLevel])
  @@index([isActive])
  @@map("programs")
}

model ProgramCourse {
  id                    Int       @id @default(autoincrement())
  programId             Int       @map("program_id")
  courseId              Int       @map("course_id")
  isRequired            Boolean   @default(true) @map("is_required") // true = required, false = elective
  recommendedSemester   Int?      @map("recommended_semester") // Which semester this course is typically taken
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  program               Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  course                Course    @relation(fields: [courseId], references: [id])

  @@unique([programId, courseId], name: "program_course_unique")
  @@index([programId])
  @@index([courseId])
  @@map("program_courses")
}

model ScientificTask {
  id              Int       @id @default(autoincrement())
  taskName        String    @map("task_name")
  taskDescription String?   @map("task_description")
  deadline        DateTime
  createdBy       Int       @map("created_by")
  departmentId    Int?      @map("department_id") // Null if created by admin (applies to all), set if created by dept head
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator         User                       @relation("ScientificTaskCreator", fields: [createdBy], references: [id])
  department      Department?                @relation(fields: [departmentId], references: [id])
  reports         TeacherScientificReport[]

  @@index([createdBy])
  @@index([departmentId])
  @@index([isActive])
  @@map("scientific_tasks")
}

model TeacherScientificReport {
  id                    Int       @id @default(autoincrement())
  scientificTaskId      Int       @map("scientific_task_id")
  teacherId             Int       @map("teacher_id")
  executionStatus       String?   @map("execution_status")
  completionPercentage  Int       @default(0) @map("completion_percentage")
  equivalentHours       Decimal   @default(0) @map("equivalent_hours") // Hours worked on the task
  filePath              String?   @map("file_path")
  fileName              String?   @map("file_name")
  status                String    @default("in_progress") // in_progress, submitted, validated, rejected
  submittedAt           DateTime? @map("submitted_at")
  validatedAt           DateTime? @map("validated_at")
  validatedBy           Int?      @map("validated_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  scientificTask        ScientificTask @relation(fields: [scientificTaskId], references: [id], onDelete: Cascade)
  teacher               User           @relation("TeacherScientificReports", fields: [teacherId], references: [id])
  validator             User?          @relation("ScientificReportValidator", fields: [validatedBy], references: [id])

  @@unique([scientificTaskId, teacherId], name: "task_teacher_unique")
  @@index([scientificTaskId])
  @@index([teacherId])
  @@index([status])
  @@map("teacher_scientific_reports")
}

model ResearchActivityTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  maxAmount   Float?   @map("max_amount")
  penalty     Float?   // Penalty % for not completing
  category    String   @default("scientific_main") // scientific_main, scientific_exchange, educational_additional, additional, educational
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacherActivities TeacherResearchActivity[]

  @@map("research_activity_templates")
}

model TeacherResearchActivity {
  id                   Int       @id @default(autoincrement())
  teacherId            Int       @map("teacher_id")
  templateId           Int       @map("template_id")
  completionPercentage Int       @default(0) @map("completion_percentage")
  filePath             String?   @map("file_path")
  fileName             String?   @map("file_name")
  status               String    @default("in_progress") // in_progress, submitted, validated, rejected
  deadline             DateTime?
  submittedAt          DateTime? @map("submitted_at")
  validatedAt          DateTime? @map("validated_at")
  validatedBy          Int?      @map("validated_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  teacher   User                     @relation("TeacherResearchActivities", fields: [teacherId], references: [id])
  template  ResearchActivityTemplate @relation(fields: [templateId], references: [id])
  validator User?                    @relation("ResearchActivityValidator", fields: [validatedBy], references: [id])

  @@unique([teacherId, templateId], name: "teacher_template_unique")
  @@index([teacherId])
  @@index([templateId])
  @@index([status])
  @@map("teacher_research_activities")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  actorLogin String   @map("actor_login")
  actorRole  String   @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model TeacherPublication {
  id                Int       @id @default(autoincrement())
  teacherId         Int       @map("teacher_id")
  title             String
  publicationType   String    @map("publication_type") // conference, national, scopus
  authors           String // List of authors
  venue             String? // Conference/Journal name
  publicationDate   DateTime? @map("publication_date")
  doi               String?   @unique // Digital Object Identifier
  isbn              String?   // International Standard Book Number
  issn              String?   // International Standard Serial Number
  url               String?   // Link to publication
  abstract          String?
  keywords          String?
  status            String    @default("draft") // draft, submitted, validated, rejected
  submittedAt       DateTime? @map("submitted_at")
  validatedAt       DateTime? @map("validated_at")
  validatedBy       Int?      @map("validated_by")
  rejectionReason   String?   @map("rejection_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  teacher           User      @relation(fields: [teacherId], references: [id])
  validator         User?     @relation("PublicationValidator", fields: [validatedBy], references: [id])

  @@index([teacherId])
  @@index([publicationType])
  @@index([status])
  @@map("teacher_publications")
}
